rules_version = '2';

// ATHLETICENTER PRO — REGLAS DE STORAGE v3 (SOPORTE DE CATÁLOGOS PDF DE GRAN TAMAÑO HASTA 250 MB)
// Escritura según rol (leído desde Firestore users/{uid}).
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function role() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'cliente')
        : 'none';
    }
    function isManager() { return signedIn() && role() in ['superadmin', 'gerencia', 'admin']; }
    function isStaff()   { return signedIn() && role() in ['superadmin', 'gerencia', 'admin', 'ventas', 'deposito']; }
    function hasProfile() { return signedIn() && role() != 'none'; }
    function isImage()   { return request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024; }
    function isLargePdf() { return request.resource.contentType == 'application/pdf' && request.resource.size < 250 * 1024 * 1024; }
    function isBroadcastMedia() {
      return (
        request.resource.contentType == 'application/pdf' ||
        request.resource.contentType.matches('image/.*') ||
        request.resource.contentType.matches('video/.*')
      ) && request.resource.size < 250 * 1024 * 1024;
    }
    function isCompetitorFile() {
      return (
        request.resource.contentType == 'application/pdf' ||
        request.resource.contentType.matches('image/.*') ||
        request.resource.contentType.matches('text/.*') ||
        request.resource.contentType.matches('application/.*')
      ) && request.resource.size < 250 * 1024 * 1024;
    }

    // Catálogos PDF Oficiales de Gran Tamaño (hasta 250 MB): lectura pública para entrega directa por WhatsApp y clientes.
    match /catalogs/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isLargePdf();
      allow delete: if isManager();
    }

    // Multimedia y Catálogos PDF de Campañas de Difusión Masiva (hasta 250 MB).
    match /broadcast-media/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isBroadcastMedia();
      allow delete: if isManager();
    }

    // Catálogos PDF / Listas de Competencia para Pricing Intelligence (hasta 250 MB).
    match /competitor-catalogs/{allPaths=**} {
      allow read: if isManager();
      allow write: if isManager() && isCompetitorFile();
      allow delete: if isManager();
    }

    // Catálogo de productos y logo: visibles públicamente, solo personal sube.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isImage();
      allow delete: if isManager();
    }
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isManager() && isImage();
    }

    // Comprobantes de pago: cualquier usuario con perfil (incluye clientes) sube (imagen o PDF hasta 25 MB).
    match /payment-receipts/{allPaths=**} {
      allow read: if hasProfile();
      allow create: if hasProfile() && (isImage() || (request.resource.contentType == 'application/pdf' && request.resource.size < 25 * 1024 * 1024));
      allow update, delete: if isManager();
    }

    // Evidencias de despacho / entrega: personal sube; clientes con perfil pueden ver (acuse de recibo).
    match /dispatch-evidence/{allPaths=**} {
      allow read: if hasProfile();
      allow create: if isStaff() && isImage();
      allow update, delete: if isManager();
    }
    match /delivery-evidence/{allPaths=**} {
      allow read: if hasProfile();
      allow create: if hasProfile() && isImage();
      allow update, delete: if isManager();
    }

    match /user-avatars/{allPaths=**} {
      allow read: if signedIn();
      allow write: if hasProfile() && isImage();
    }

    // Todo lo demás: cerrado.
  }
}
