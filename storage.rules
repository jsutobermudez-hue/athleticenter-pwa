rules_version = '2';

// ATHLETICENTER PRO — REGLAS DE STORAGE v2
// Solo imágenes, máximo 8 MB. Escritura según rol (leído desde Firestore users/{uid}).
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function role() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'cliente')
        : 'none';
    }
    function isManager() { return signedIn() && role() in ['superadmin', 'gerencia', 'admin']; }
    function isStaff()   { return signedIn() && role() in ['superadmin', 'gerencia', 'admin', 'ventas', 'deposito']; }
    function hasProfile() { return signedIn() && role() != 'none'; }
    function isImage()   { return request.resource.contentType.matches('image/.*') && request.resource.size < 8 * 1024 * 1024; }

    // Catálogo y logo: visibles públicamente, solo personal sube.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isImage();
      allow delete: if isManager();
    }
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isManager() && isImage();
    }

    // Comprobantes de pago: cualquier usuario con perfil (incluye clientes) sube; lee el personal y quien lo subió.
    match /payment-receipts/{allPaths=**} {
      allow read: if hasProfile();
      allow create: if hasProfile() && isImage();
      allow update, delete: if isManager();
    }

    // Evidencias de despacho / entrega: personal sube; clientes con perfil pueden ver (acuse de recibo).
    match /dispatch-evidence/{allPaths=**} {
      allow read: if hasProfile();
      allow create: if isStaff() && isImage();
      allow update, delete: if isManager();
    }
    match /delivery-evidence/{allPaths=**} {
      allow read: if hasProfile();
      allow create: if hasProfile() && isImage();
      allow update, delete: if isManager();
    }

    match /user-avatars/{allPaths=**} {
      allow read: if signedIn();
      allow write: if hasProfile() && isImage();
    }

    // Todo lo demás: cerrado.
  }
}
