rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para perfiles de usuario y su comunicación (Permite a Admin crear clientes)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; 

      match /directMessages/{messageId} {
        allow read, write: if request.auth != null;
      }

      match /notifications/{notificationId} {
        allow read, write: if request.auth != null;
      }

      match /sentMessages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Reglas para productos e inventario (Permite guardar en subcolección /private/pricing)
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /stockHistory/{logId} {
        allow read, write: if request.auth != null;
      }

      match /private/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // Reglas para la gestión comercial y pedidos
    match /orders/{orderId} {
      allow read, write: if request.auth != null;

      match /orderItems/{itemId} {
        allow read, write: if request.auth != null;
      }

      match /payments/{paymentId} {
        allow read, write: if request.auth != null;
      }
    }

    match /quotes/{quoteId} {
      allow read, write: if request.auth != null;

      match /quoteItems/{itemId} {
        allow read, write: if request.auth != null;
      }
    }

    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    match /carriers/{carrierId} {
      allow read, write: if request.auth != null;
    }

    match /commissions/{commissionId} {
      allow read, write: if request.auth != null;
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /auditLogs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /companyProfile/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /suppliers/{supplierId} {
      allow read, write: if request.auth != null;
    }

    match /purchaseOrders/{poId} {
      allow read, write: if request.auth != null;
    }

    match /priceAdjustmentHistory/{historyId} {
      allow read, write: if request.auth != null;
    }

    match /supportTickets/{ticketId} {
      allow read, write: if request.auth != null;
    }

    // Fallback de seguridad global para cualquier colección o subcolección de usuarios autenticados
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
