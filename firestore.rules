rules_version = '2';

// =====================================================================
// ATHLETICENTER PRO — REGLAS DE SEGURIDAD FIRESTORE v2 (por rol)
// Roles: superadmin | gerencia | admin | ventas | deposito | cliente
// El rol se lee del perfil users/{uid}. Nadie puede cambiarse su propio rol.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return hasProfile() ? me().get('role', 'cliente') : 'none'; }

    function isSuper()   { return role() == 'superadmin'; }
    function isManager() { return role() in ['superadmin', 'gerencia', 'admin']; }
    function isStaff()   { return role() in ['superadmin', 'gerencia', 'admin', 'ventas', 'deposito']; }
    function isWarehouse() { return isManager() || role() == 'deposito'; }
    function isClient()  { return role() == 'cliente'; }

    // El cliente opera sobre su ficha de cliente (associatedCustomerId) o, en su defecto, su propio uid.
    function myCustomerId() { return me().get('associatedCustomerId', request.auth.uid); }
    function ownsCustomer(cid) { return signedIn() && (cid == request.auth.uid || (hasProfile() && cid == myCustomerId())); }

    function orderDoc(orderId) { return get(/databases/$(database)/documents/orders/$(orderId)).data; }
    function quoteDoc(quoteId) { return get(/databases/$(database)/documents/quotes/$(quoteId)).data; }

    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function unchanged(field) { return request.resource.data.get(field, null) == resource.data.get(field, null); }

    // Validadores de esquema para bitácora saliente de WhatsApp y borradores del Agente Comandante
    function isValidWhatsAppOutboundLog(data) {
      return data.keys().hasAll(['phone', 'status'])
             && data.keys().hasOnly([
               'phone', 'recipientName', 'recipientType', 'module',
               'orderId', 'quoteId', 'campaignId', 'text',
               'hasMedia', 'mediaType', 'fileName',
               'senderName', 'senderRole', 'source', 'status',
               'provider', 'messageId', 'error', 'createdAt'
             ])
             && data.phone is string && data.phone.size() <= 40
             && data.status in ['sent', 'failed']
             && (!('recipientName' in data) || (data.recipientName is string && data.recipientName.size() <= 200))
             && (!('recipientType' in data) || data.recipientType in ['cliente', 'equipo', 'tercero'])
             && (!('module' in data) || (data.module is string && data.module.size() <= 60))
             && (!('orderId' in data) || data.orderId == null || (data.orderId is string && data.orderId.size() <= 100))
             && (!('quoteId' in data) || data.quoteId == null || (data.quoteId is string && data.quoteId.size() <= 100))
             && (!('campaignId' in data) || data.campaignId == null || (data.campaignId is string && data.campaignId.size() <= 100))
             && (!('text' in data) || (data.text is string && data.text.size() <= 4500))
             && (!('hasMedia' in data) || data.hasMedia is bool)
             && (!('mediaType' in data) || data.mediaType in ['none', 'pdf', 'image', 'video'])
             && (!('fileName' in data) || data.fileName == null || (data.fileName is string && data.fileName.size() <= 255))
             && (!('senderName' in data) || data.senderName == null || (data.senderName is string && data.senderName.size() <= 150))
             && (!('senderRole' in data) || data.senderRole == null || (data.senderRole is string && data.senderRole.size() <= 60))
             && (!('source' in data) || data.source in ['manual', 'auto', 'campaign', 'commander'])
             && (!('provider' in data) || data.provider == null || (data.provider is string && data.provider.size() <= 60))
             && (!('messageId' in data) || data.messageId == null || (data.messageId is string && data.messageId.size() <= 200))
             && (!('error' in data) || data.error == null || (data.error is string && data.error.size() <= 1000))
             && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidWhatsAppCommanderDraft(data) {
      return data is map
             && data.keys().size() <= 40
             && (!('title' in data) || data.title == null || (data.title is string && data.title.size() <= 200))
             && (!('instruction' in data) || data.instruction == null || (data.instruction is string && data.instruction.size() <= 4000))
             && (!('message' in data) || data.message == null || (data.message is string && data.message.size() <= 5000))
             && (!('status' in data) || (data.status is string && data.status.size() <= 40));
    }

    // ---------- Usuarios ----------
    match /users/{userId} {
      allow read: if signedIn();

      // Alta: gerencia/admin crean cuentas; vendedores pueden registrar clientes (sin campos privilegiados); un usuario solo puede auto-registrarse como cliente.
      allow create: if (isManager() && (request.resource.data.get('role', 'cliente') != 'superadmin' || isSuper()))
                    || (role() == 'ventas'
                        && request.resource.data.get('role', '') == 'cliente'
                        && !request.resource.data.keys().hasAny(['commissionRate', 'salesGoal', 'isActive']))
                    || (signedIn() && request.auth.uid == userId && request.resource.data.get('role', 'cliente') == 'cliente');

      // Edición: el propio usuario NO puede tocar rol ni vínculo de cliente ni comisiones.
      // Gerencia/admin editan a otros; solo superadmin asigna o modifica superadmins.
      // Vendedores pueden editar únicamente perfiles de clientes existentes sin cambiar rol ni campos privilegiados.
      allow update: if (signedIn() && request.auth.uid == userId
                        && unchanged('role') && unchanged('associatedCustomerId')
                        && unchanged('commissionRate') && unchanged('isActive'))
                    || (isManager()
                        && (isSuper() || (resource.data.get('role', '') != 'superadmin'
                                          && request.resource.data.get('role', '') != 'superadmin')))
                    || (role() == 'ventas'
                        && resource.data.get('role', '') == 'cliente'
                        && request.resource.data.get('role', '') == 'cliente'
                        && unchanged('role') && unchanged('commissionRate') && unchanged('isActive')
                        && onlyChanges(['id', 'name', 'email', 'role', 'status', 'associatedCustomerId', 'avatarUrl', 'phone', 'address', 'identityCard', 'updatedAt']));

      allow delete: if isSuper() || (isManager() && resource.data.get('role', '') != 'superadmin');

      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth.uid == userId || isManager();
        allow create: if signedIn();
      }
      match /directMessages/{messageId} {
        allow read, write: if signedIn();
      }
      match /sentMessages/{messageId} {
        allow read, write: if request.auth.uid == userId || isManager();
      }
    }

    // ---------- Catálogo ----------
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if isManager();

      match /stockHistory/{logId} {
        allow read, create: if isStaff();
        allow update, delete: if false;
      }
      match /priceHistory/{logId} {
        allow read, create: if isStaff();
        allow update, delete: if false;
      }
      // Costos y estructura de precios: solo gerencia/admin/depósito.
      match /private/{docId} {
        allow read, write: if isWarehouse();
      }
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isManager();
    }

    // ---------- Pedidos ----------
    match /orders/{orderId} {
      allow read: if isStaff() || ownsCustomer(resource.data.get('customerId', ''));

      allow create: if isStaff()
                    || (isClient()
                        && ownsCustomer(request.resource.data.get('customerId', ''))
                        && request.resource.data.get('status', '') in ['Pendiente', 'Borrador']
                        && request.resource.data.get('amountPaid', 0) == 0);

      // El cliente solo puede: editar su borrador, o pasar su pedido a "En Verificación" al reportar un pago,
      // o solicitar anulación. Nunca montos pagados, crédito ni aprobaciones.
      allow update: if isStaff()
                    || (isClient() && ownsCustomer(resource.data.get('customerId', ''))
                        && unchanged('customerId') && unchanged('amountPaid')
                        && (resource.data.get('status', '') == 'Borrador'
                              && request.resource.data.get('status', '') in ['Borrador', 'Pendiente']
                            || onlyChanges(['status', 'updatedAt'])
                              && request.resource.data.status == 'En Verificación'
                            || onlyChanges(['cancellationRequested', 'cancellationReason', 'cancellationRequestedAt', 'updatedAt'])));

      allow delete: if isManager();

      match /orderItems/{itemId} {
        allow read: if isStaff() || ownsCustomer(orderDoc(orderId).get('customerId', ''));
        allow create: if isStaff()
                      || (ownsCustomer(orderDoc(orderId).get('customerId', ''))
                          && orderDoc(orderId).get('status', '') in ['Pendiente', 'Borrador']);
        allow update, delete: if isStaff()
                      || (ownsCustomer(orderDoc(orderId).get('customerId', ''))
                          && orderDoc(orderId).get('status', '') == 'Borrador');
      }

      match /payments/{paymentId} {
        allow read: if isStaff() || ownsCustomer(orderDoc(orderId).get('customerId', ''));
        // El cliente solo reporta pagos pendientes de verificación, a su nombre.
        allow create: if isStaff()
                      || (ownsCustomer(orderDoc(orderId).get('customerId', ''))
                          && request.resource.data.get('status', '') == 'pending_verification'
                          && request.resource.data.get('registeredBy', '') == request.auth.uid);
        allow update, delete: if isManager();
      }

      match /statusHistory/{entryId} {
        allow read: if isStaff() || ownsCustomer(orderDoc(orderId).get('customerId', ''));
        allow create: if isStaff();
        allow update, delete: if false;
      }
    }

    // Consultas collectionGroup('payments') (caja, estado de cuenta del cliente)
    match /{path=**}/payments/{paymentId} {
      allow read: if isStaff() || (signedIn() && resource.data.get('registeredBy', '') == request.auth.uid)
                  || (hasProfile() && resource.data.get('registeredBy', '') == myCustomerId());
    }

    // Consultas collectionGroup('orderItems') (analítica comercial, desglose de pedidos)
    match /{path=**}/orderItems/{itemId} {
      allow read: if isStaff();
    }

    // ---------- Cotizaciones ----------
    match /quotes/{quoteId} {
      allow read: if isStaff() || ownsCustomer(resource.data.get('customerId', ''));
      allow create: if isStaff() || (isClient() && ownsCustomer(request.resource.data.get('customerId', '')));
      allow update: if isStaff()
                    || (isClient() && ownsCustomer(resource.data.get('customerId', ''))
                        && unchanged('customerId') && unchanged('totalAmount') && unchanged('salespersonId'));
      allow delete: if isManager();

      match /quoteItems/{itemId} {
        allow read: if isStaff() || ownsCustomer(quoteDoc(quoteId).get('customerId', ''));
        allow write: if isStaff();
      }
    }

    // ---------- Clientes ----------
    match /customers/{customerId} {
      allow read: if isStaff() || ownsCustomer(customerId);
      allow create, update: if isStaff();
      allow delete: if isManager();
    }

    // ---------- Logística ----------
    match /carriers/{carrierId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /stockMovements/{movementId} {
      allow read, create: if isStaff();
      allow update, delete: if isManager();
    }

    // ---------- Compras ----------
    match /suppliers/{supplierId} {
      allow read, write: if isWarehouse();
    }
    match /purchaseOrders/{poId} {
      allow read, write: if isWarehouse();
    }

    // ---------- Finanzas ----------
    match /commissions/{commissionId} {
      allow read: if isManager() || (isStaff() && resource.data.get('salespersonId', '') == request.auth.uid);
      allow create: if isStaff();
      allow update, delete: if isManager();
    }
    match /expenses/{expenseId} {
      allow read, write: if isManager();
    }
    match /treasuryTransactions/{txId} {
      allow read, write: if isManager();
    }
    match /priceAdjustmentHistory/{historyId} {
      allow read, write: if isManager();
    }

    // ---------- Auditoría (solo agregar, nunca editar ni borrar) ----------
    match /auditLogs/{logId} {
      allow read: if isManager();
      allow create: if signedIn();
      allow update, delete: if false;
    }
    match /audit_logs/{logId} {
      allow read: if isManager();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ---------- Configuración ----------
    match /system/{docId} {
      allow read: if true;
      allow write: if isManager();
    }
    match /companyProfile/{docId} {
      allow read: if true;
      allow write: if isManager();
    }

    // ---------- Marketing ----------
    match /marketing_campaigns/{campaignId} {
      allow read, write: if isManager();
    }
    match /catalog_leads/{leadId} {
      allow read, write: if isStaff();
    }
    match /crm_hot_leads/{leadId} {
      allow read, create, update: if isStaff();
      allow delete: if isManager();
    }
    match /crm_lead_enrichments/{enrichmentId} {
      allow read, create, update: if isStaff();
      allow delete: if isManager();
    }
    match /whatsapp_inbound_logs/{logId} {
      allow read, create, update: if isStaff();
      allow delete: if isManager();
    }
    // Historial inmutable de envíos de WhatsApp: solo gerencia/admin/superadmin leen; staff registra; nadie edita ni borra.
    match /whatsapp_outbound_logs/{logId} {
      allow read: if isManager();
      allow create: if isStaff() && isValidWhatsAppOutboundLog(request.resource.data);
      allow update, delete: if false;
    }
    // Borradores del Agente Comandante de Promociones: exclusivo para gerencia/admin/superadmin.
    match /whatsapp_commander_drafts/{draftId} {
      allow read, delete: if isManager();
      allow create, update: if isManager() && isValidWhatsAppCommanderDraft(request.resource.data);
    }

    // ---------- Mensajería interna ----------
    match /chats/{chatId} {
      allow read, write: if signedIn();
      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }
    match /group_channels/{channelId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isManager();
      match /messages/{messageId} {
        allow read, create, update: if signedIn();
        allow delete: if isManager();
      }
    }
    match /supportTickets/{ticketId} {
      allow read, create, update: if signedIn();
      allow delete: if isManager();
    }

    // Sin regla comodín: cualquier colección no declarada queda cerrada por defecto.
  }
}
